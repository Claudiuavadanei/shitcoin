# ==========================================
# CRYPTO SNIPER & PROFIT BOT CONFIGURATION
# ==========================================

# Server Port and Host
PORT=8080
HOST=0.0.0.0

# Trading Mode: "PAPER" (virtual money simulation) or "LIVE" (real blockchain swaps)
TRADING_MODE=PAPER

# Default Virtual Starting Balance (for Paper Trading)
PAPER_BALANCE_SOL=10.0
PAPER_BALANCE_USD=1500.0

# Strategy Settings
AUTO_BUY_ENABLED=true
BUY_AMOUNT_SOL=0.1
BUY_AMOUNT_USD=15.0
MAX_OPEN_POSITIONS=30

# Profit & Risk Targets

TAKE_PROFIT_PERCENT=30.0
TRAILING_STOP_ENABLED=true
TRAILING_STOP_OFFSET_PERCENT=5.0
STOP_LOSS_PERCENT=15.0
MAX_HOLD_TIME_MINUTES=60

# Safety & Anti-Rug Filters
MIN_LIQUIDITY_USD=2000.0
MIN_VOLUME_USD=500.0
MAX_DEV_HOLDING_PERCENT=15.0
MAX_BUY_TAX_PERCENT=5.0
MAX_SELL_TAX_PERCENT=5.0
MIN_SAFETY_SCORE=65

# Blockchain & DEX Keys (Optional - only required if TRADING_MODE=LIVE)
# Solana Setup
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=

# EVM Setup (BSC / Base / Ethereum)
EVM_RPC_URL=https://bsc-dataseed.binance.org/
EVM_PRIVATE_KEY=
